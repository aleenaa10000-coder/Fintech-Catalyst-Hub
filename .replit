modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Health Monitor"

[[workflows.workflow]]
name = "Health Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/healthcheck.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 8084
externalPort = 3001

[[ports]]
localPort = 18082
externalPort = 3003

[[ports]]
localPort = 21096
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
REPORT_FROM_EMAIL = "FintechPressHub <hello@fintechpresshub.com>"
ADMIN_EMAILS = "hello@fintechpresshub.com,jasmine.offpageseospecialist@hotmail.com"
CONTACT_NOTIFY_TO = "hello@fintechpresshub.com"
PITCH_RECIPIENT_EMAIL = "hello@fintechpresshub.com"
"RESEND.COM_API_KEY" = "re_Tf8YoMWQ_ 5hmKK9gJh1Fxxo93WuDw2pMp"

