# =============================================================================
# FintechPressHub — environment template
# =============================================================================
# Copy this file to `.env` for local development.
# On Hostinger, paste each variable into hPanel → Node.js app → Environment Variables.
# Never commit a populated `.env` file.
#
# See docs/hostinger-deployment.md for the complete Hostinger setup guide.
# =============================================================================

# ----- Database (required) ---------------------------------------------------
# Full PostgreSQL connection string.
#
# LOCAL DEV:   Use the Replit Database tool, or a local Postgres instance.
# HOSTINGER:   Hostinger does not include built-in PostgreSQL.
#              Use Neon — free tier, no credit card, 2-minute setup:
#              1. Sign up at https://neon.tech
#              2. Create a project → Connection Details → copy the string below
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ----- API server ------------------------------------------------------------
# Port the Express server binds to.
# LOCAL DEV:   8080 (Vite dev server runs separately on 5000)
# HOSTINGER:   Leave unset — Hostinger assigns PORT automatically.
PORT=8080

# Controls security headers, www→canonical redirect, and production static-file serving.
# Must be "production" on Hostinger. Leave as "development" locally.
NODE_ENV=development

# ----- Site URL (required in production) -------------------------------------
# Canonical public URL — no trailing slash.
# Used in sitemaps, RSS feeds, canonical tags, IndexNow pings, og:url, and emails.
SITE_URL=https://www.fintechpresshub.com

# ----- Admin access ----------------------------------------------------------
# Comma-separated emails that can access /admin/*. Case-insensitive.
# These emails are auto-created as admin users on every server start when
# ADMIN_PASSWORD is also set.
ADMIN_EMAILS=you@example.com

# Password for the email+password admin login at /admin/login.
# Used on Hostinger (and any non-Replit host) where Replit OIDC is unavailable.
# Use a strong password — minimum 16 characters.
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign session cookies. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-string

# ----- Email / notifications -------------------------------------------------
# Option A: Resend (recommended — sign up at resend.com, free tier)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPORT_FROM_EMAIL=FintechPressHub <hello@fintechpresshub.com>
#
# Option B: SMTP (Hostinger Business Mail works here)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=hello@fintechpresshub.com
# SMTP_PASS=your-mail-password
#
# Destination addresses for notification emails.
PITCH_RECIPIENT_EMAIL=editorial@fintechpresshub.com
CONTACT_NOTIFY_TO=hello@fintechpresshub.com

# ----- SEO / IndexNow --------------------------------------------------------
# Random alphanumeric key (8–128 chars) from https://www.indexnow.org/
# The server exposes it at /<key>.txt for search engine ownership verification.
INDEXNOW_KEY=your-indexnow-key-here

# ----- Object storage (cover image uploads) ----------------------------------
# S3-compatible credentials. Hostinger Object Storage or any S3 provider.
# Hostinger endpoint: https://s3.<region>.hostingerapp.com
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
OBJECT_STORAGE_ENDPOINT=https://s3.eu-central-1.hostingerapp.com
OBJECT_STORAGE_BUCKET_NAME=fintechpresshub-assets
OBJECT_STORAGE_REGION=eu-central-1
# Public base URL for served objects (no trailing slash).
OBJECT_STORAGE_PUBLIC_URL=https://fintechpresshub-assets.s3.eu-central-1.hostingerapp.com

# ----- Local uploads directory (alternative to S3) ---------------------------
# Absolute path where uploaded files are stored on disk.
# HOSTINGER: Set to a directory OUTSIDE the app root so uploads survive redeploys.
# Example: /home/USERNAME/uploads
# LOCAL_UPLOADS_DIR=/home/user/uploads

# ----- Replit OIDC (Replit only — leave blank on Hostinger) ------------------
# These are set automatically on Replit. On Hostinger, the /api/login route
# returns 503 gracefully; use /admin/login with ADMIN_PASSWORD instead.
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# ----- PR amplification (optional) ------------------------------------------
# Webhook URL fired after every blog publish.
# Leave blank to disable silently.
# PR_WEBHOOK_URL=https://hooks.slack.com/services/xxx
