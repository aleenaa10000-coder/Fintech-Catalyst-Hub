# =============================================================================
# FintechPressHub — environment template
# =============================================================================
# Copy this file to `.env` for local development, or — when running on Replit —
# add each variable as a Secret in the Secrets pane (Tools → Secrets).
# On Hostinger, paste these into the Node.js app's "Environment Variables" panel.
# Never commit a populated `.env` file.
# =============================================================================

# ----- Database (required) ---------------------------------------------------
# A Postgres connection string. On Replit, provision the built-in PostgreSQL
# database from the Database tool and `DATABASE_URL` will be set automatically.
# On Hostinger, create a MySQL or external Postgres database and paste the
# connection string here (Postgres is recommended for full compatibility).
DATABASE_URL=postgres://user:password@host:5432/dbname

# ----- API server ------------------------------------------------------------
# Port the Express server binds to.
# - Replit:    set to 8080 (the internal API port; the frontend runs on 5000)
# - Hostinger: Hostinger sets PORT automatically — do not override it there.
# - Local dev: defaults to 3000 if unset
PORT=8080
NODE_ENV=development

# Optional override for the Vite dev-proxy target. Defaults to
# http://127.0.0.1:8080 if unset (development only).
# API_PROXY_TARGET=http://127.0.0.1:8080

# ----- Frontend dev server (Replit / local dev only) ------------------------
# Override to change the Vite dev server port. Not needed on Hostinger since
# the production build is served as static files by the API server process.
# PORT=5000
# BASE_PATH=/

# ----- Replit OIDC auth (Replit only) ----------------------------------------
# REPL_ID is set automatically on Replit. If you are deploying to a non-Replit
# host (e.g. Hostinger), leave this blank — auth routes will gracefully return
# 503 and all public pages continue to work without authentication.
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# ----- Site URL (required for SEO features in production) --------------------
# Used in sitemaps, RSS feeds, IndexNow pings, and outgoing emails.
# Must be the exact canonical domain without a trailing slash.
SITE_URL=https://www.yourdomain.com

# ----- Email / notifications (optional) -------------------------------------
# Two delivery options — only one is required:
#
# Option A: Resend (recommended)
#   Sign up at resend.com, verify your domain, then set the API key below.
#   REPORT_FROM_EMAIL accepts "Name <addr@domain>" format.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPORT_FROM_EMAIL=FintechPressHub <hello@yourdomain.com>
#
# Option B: SMTP (any provider — Hostinger Business mail works here)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=changeme
#
# Destination addresses for notification emails.
# Strip any surrounding parentheses or angle brackets — use plain addresses.
PITCH_RECIPIENT_EMAIL=editorial@example.com
CONTACT_NOTIFY_TO=hello@example.com

# ----- Admin allowlist (required to use /admin/blog on Replit) ---------------
# Comma-separated, case-insensitive list of Replit account emails allowed to
# sign in to /admin/blog. Not used on Hostinger (auth is Replit-specific).
ADMIN_EMAILS=you@example.com,teammate@example.com

# ----- SEO / IndexNow (optional, production only) ----------------------------
# Generate a key at https://www.bing.com/indexnow and paste it below.
# The server exposes it at /<key>.txt so Bing/Yandex can verify ownership.
INDEXNOW_KEY=your-indexnow-key-here
