# =============================================================================
# FintechPressHub — environment template
# =============================================================================
# Copy this file to `.env` for local development, or — when running on Replit —
# add each variable as a Secret in the Secrets pane (Tools → Secrets).
# On Hostinger, paste these into hPanel → Node.js app → Environment Variables.
# Never commit a populated `.env` file.
#
# See docs/hostinger-deployment.md for the full migration checklist.
# =============================================================================

# ----- Database (required) ---------------------------------------------------
# Full PostgreSQL connection string.
# Replit: provisioned automatically via the Database tool.
# Hostinger: hPanel → Databases → PostgreSQL → Connection details.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Individual PG vars (used by some drivers as a fallback to DATABASE_URL).
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=fintechpresshub

# ----- API server ------------------------------------------------------------
# Port the Express server binds to.
# Replit:    8080 (frontend runs separately on 5000)
# Hostinger: set to the port Hostinger assigns, or leave blank to use default
PORT=8080

# Controls security headers, www redirect, and production static-file serving.
# Must be "production" on Hostinger. Leave as "development" locally.
NODE_ENV=development

# ----- Site URL (required for all SEO features) ------------------------------
# Canonical public URL — no trailing slash. Must match your DNS/www setting.
# Used in sitemaps, RSS feeds, canonical tags, IndexNow pings, og:url, and emails.
SITE_URL=https://www.fintechpresshub.com

# ----- Replit OIDC auth (Replit only) ----------------------------------------
# Set automatically on Replit. Leave blank on Hostinger — auth routes return
# 503 gracefully and all public pages continue to work unauthenticated.
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# Optional override for the Vite dev-proxy target (development only).
# API_PROXY_TARGET=http://127.0.0.1:8080

# ----- Admin access ----------------------------------------------------------
# Comma-separated Replit account emails with access to /admin/*.
# Case-insensitive. Not used on Hostinger (Replit auth is Replit-specific).
ADMIN_EMAILS=you@example.com,teammate@example.com

# Fallback admin password for the local /admin/login route on non-Replit hosts.
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign session cookies. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-string

# ----- Email / notifications -------------------------------------------------
# Option A: Resend (recommended — sign up at resend.com, verify your domain)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPORT_FROM_EMAIL=FintechPressHub <hello@fintechpresshub.com>
#
# Option B: SMTP (any provider — Hostinger Business Mail works here)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=hello@fintechpresshub.com
# SMTP_PASS=your-mail-password
#
# Destination addresses for notification emails.
PITCH_RECIPIENT_EMAIL=editorial@fintechpresshub.com
CONTACT_NOTIFY_TO=hello@fintechpresshub.com

# ----- PR amplification (optional) ------------------------------------------
# Webhook URL fired after every immediate blog publish. Use a Slack incoming
# webhook, Make.com catch webhook, or Zapier webhook URL.
# Leave blank to disable PR amplification silently.
# PR_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# ----- SEO / IndexNow --------------------------------------------------------
# Random alphanumeric key (8–128 chars) from https://www.indexnow.org/
# The server exposes it at /<key>.txt for ownership verification.
INDEXNOW_KEY=your-indexnow-key-here

# ----- Object storage (cover image uploads) ----------------------------------
# S3-compatible credentials. Hostinger Object Storage or any S3 provider.
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
OBJECT_STORAGE_ENDPOINT=https://s3.eu-central-1.hostingerapp.com
OBJECT_STORAGE_BUCKET_NAME=fintechpresshub-assets
OBJECT_STORAGE_REGION=eu-central-1
# Public base URL for served objects (no trailing slash).
OBJECT_STORAGE_PUBLIC_URL=https://fintechpresshub-assets.s3.eu-central-1.hostingerapp.com
